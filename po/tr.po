msgstr "Devre dışı bırakıldı"

#. Translators: This detailed message indicates that indentation will not be
#. spoken.
#: src/orca/messages.py:922
msgid "Spoken indentation disabled."
msgstr "Sesli girinti devre dışı bırakıldı."

