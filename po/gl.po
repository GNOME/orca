msgstr "non seleccionado"

#. Translators: This is a state which applies to a table cell.
#: src/orca/object_properties.py:547
msgctxt "tablecell"
msgid "not selected"
msgstr "non seleccionado"

#. Translators: This is a state which applies to a link.
#: src/orca/object_properties.py:550
