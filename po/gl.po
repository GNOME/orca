#. "semi_condensed", "normal", "semi_expanded", "expanded",
#. "extra_expanded" or "ultra_expanded".
#. See: https://docs.gtk.org/atk/enum.TextAttribute.html
#: src/orca/text_attribute_names.py:155
msgctxt "textattr"
msgid "stretch"
msgstr "estirar"

