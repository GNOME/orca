#. Translators: the object navigator allows users to explore UI objects presented
#. as a hierarchy.
#: src/orca/cmdnames.py:1092
msgid "Go to the parent of the object with navigator focus."
msgstr "Aller au parent de l’objet possédant le focus de navigation."

#. Translators: the object navigator allows users to explore UI objects presented
#. as a hierarchy.
#: src/orca/cmdnames.py:1096
msgid "Go to the first child of the object with navigator focus."
msgstr "Aller au premier enfant de l’objet possédant le focus de navigation."

#. Translators: the object navigator allows users to explore UI objects presented
#. as a hierarchy.
#: src/orca/cmdnames.py:1100
msgid "Go to the next sibling of the object with navigator focus."
msgstr ""
"Aller à l’objet frère suivant l’objet possédant le focus de navigation."

#. Translators: the object navigator allows users to explore UI objects presented
#. as a hierarchy.
#: src/orca/cmdnames.py:1104
msgid "Go to the previous sibling of the object with navigator focus."
msgstr ""
"Aller à l’objet frère précédent l’objet possédant le focus de navigation."

#. Translators: the object navigator allows users to explore UI objects presented
#. as a hierarchy. Users are also able to synthesize a click on the objects.
#: src/orca/cmdnames.py:1108
msgid "Click on the object with navigator focus."
msgstr "Cliquer sur l’objet possédant le focus de navigation."

#. Translators: the object navigator allows users to explore UI objects presented
#. as a hierarchy. This hierarchy can be simplified, and the simplification can be
#. toggled on and off.
#: src/orca/cmdnames.py:1113
msgid "Toggle simplified object navigation."
msgstr "Activer ou désactiver la navigation dans les objets."

#. Translators: this is for navigating among paragraphs in a document.
#: src/orca/cmdnames.py:1116
msgid "Go to previous paragraph"
msgstr "Revenir au paragraphe précédent"

#. Translators: this is for navigating among paragraphs in a document.
#: src/orca/cmdnames.py:1119
msgid "Go to next paragraph"
msgstr "Aller au paragraphe suivant"

#. Translators: this is for navigating among paragraphs in a document.
#: src/orca/cmdnames.py:1122
msgid "Display a list of paragraphs"
msgstr "Afficher une liste des paragraphes"

#. Translators: this is for navigating among radio buttons in a document.
#: src/orca/cmdnames.py:1125
msgid "Go to previous radio button"
msgstr "Revenir au bouton radio précédent"

#. Translators: this is for navigating among radio buttons in a document.
#: src/orca/cmdnames.py:1128
msgid "Go to next radio button"
msgstr "Aller au bouton radio suivant"

#. Translators: this is for navigating among radio buttons in a document.
#: src/orca/cmdnames.py:1131
msgid "Display a list of radio buttons"
msgstr "Afficher une liste des boutons radio"

#. Translators: this is for navigating among separators (e.g. <hr>) in a
#. document.
#: src/orca/cmdnames.py:1135
msgid "Go to previous separator"
msgstr "Revenir au séparateur précédent"

#. Translators: this is for navigating among separators (e.g. <hr>) in a
#. document.
#: src/orca/cmdnames.py:1139
msgid "Go to next separator"
msgstr "Aller au séparateur suivant"

#. Translators: this is for navigating among tables in a document.
#: src/orca/cmdnames.py:1142
msgid "Go to previous table"
msgstr "Revenir au tableau précédent"

#. Translators: this is for navigating among tables in a document.
#: src/orca/cmdnames.py:1145
msgid "Go to next table"
msgstr "Aller au tableau suivant"

#. Translators: this is for navigating among tables in a document.
#: src/orca/cmdnames.py:1148
msgid "Display a list of tables"
msgstr "Afficher une liste des tableaux"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1151
msgid "Go down one cell"
msgstr "Se déplacer d’une cellule vers le bas"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1154
msgid "Go to the first cell in a table"
msgstr "Aller à la première cellule d’un tableau"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1157
msgid "Go to the last cell in a table"
msgstr "Aller à la dernière cellule d’un tableau"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1160
msgid "Go left one cell"
msgstr "Se déplacer d’une cellule vers la gauche"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1163
msgid "Go right one cell"
msgstr "Se déplacer d’une cellule vers la droite"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1166
msgid "Go up one cell"
msgstr "Se déplacer d’une cellule vers le haut"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1169
msgid "Go to the beginning of the row"
msgstr "Aller au début de la ligne"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1172
msgid "Go to the end of the row"
msgstr "Aller à la fin de la ligne"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1175
msgid "Go to the top of the column"
msgstr "Aller au début de la colonne"

#. Translators: this is for navigating among table cells in a document.
#: src/orca/cmdnames.py:1178
msgid "Go to the bottom of the column"
msgstr "Aller à la fin de la colonne"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command enters that mode when
#. the user is on a math element.
#: src/orca/cmdnames.py:1183
msgctxt "mathcat"
msgid "Enter math navigation mode"
msgstr "Activer le mode navigation mathématique"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command exits that mode.
#: src/orca/cmdnames.py:1187
msgctxt "mathcat"
msgid "Exit math navigation mode"
msgstr "Quitter le mode navigation mathématique"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the next sibling
#. at the current level of the math expression tree.
#: src/orca/cmdnames.py:1192
msgctxt "mathcat"
msgid "Move to next item"
msgstr "Se déplacer à l’élément suivant"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the previous
#. sibling at the current level of the math expression tree.
#: src/orca/cmdnames.py:1197
msgctxt "mathcat"
msgid "Move to previous item"
msgstr "Se déplacer à l’élément précédent"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves from an item down
#. into its children, e.g. from a fraction into its numerator and denominator.
#: src/orca/cmdnames.py:1202
msgctxt "mathcat"
msgid "Zoom in"
msgstr "Zoom avant"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves from an item back
#. up to its parent, e.g. from a numerator back to the containing fraction.
#: src/orca/cmdnames.py:1207
msgctxt "mathcat"
msgid "Zoom out"
msgstr "Zoom arrière"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command descends as deep as
#. possible into the current item, going straight to the innermost child.
#: src/orca/cmdnames.py:1212
msgctxt "mathcat"
msgid "Zoom in completely"
msgstr "Zoom avant maximal"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command goes all the way back
#. up to the root of the math expression.
#: src/orca/cmdnames.py:1217
msgctxt "mathcat"
msgid "Zoom out completely"
msgstr "Zoom arrière maximal"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the first item.
#: src/orca/cmdnames.py:1221
msgctxt "mathcat"
msgid "Move to start"
msgstr "Se déplacer au début"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the last item.
#: src/orca/cmdnames.py:1225
msgctxt "mathcat"
msgid "Move to end"
msgstr "Se déplacer à la fin"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the start of
#. the current line in a multi-line math expression.
#: src/orca/cmdnames.py:1230
msgctxt "mathcat"
msgid "Move to line start"
msgstr "Se déplacer au début de la ligne"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the end of
#. the current line in a multi-line math expression.
#: src/orca/cmdnames.py:1235
msgctxt "mathcat"
msgid "Move to line end"
msgstr "Se déplacer à la fin de la ligne"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the top of the
#. current column in a math table (matrix, determinant, etc.).
#: src/orca/cmdnames.py:1240
msgctxt "mathcat"
msgid "Move to column start"
msgstr "Se déplacer au début de la colonne"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the bottom of
#. the current column in a math table (matrix, determinant, etc.).
#: src/orca/cmdnames.py:1245
msgctxt "mathcat"
msgid "Move to column end"
msgstr "Se déplacer à la fin de la colonne"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the previous
#. cell in a math table or columnar arithmetic expression.
#: src/orca/cmdnames.py:1250
msgctxt "mathcat"
msgid "Move to previous cell"
msgstr "Se déplacer à la cellule précédente"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves to the next cell
#. in a math table or columnar arithmetic expression.
#: src/orca/cmdnames.py:1255
msgctxt "mathcat"
msgid "Move to next cell"
msgstr "Se déplacer à la cellule suivante"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves up one cell in
#. a math table or columnar arithmetic expression.
#: src/orca/cmdnames.py:1260
msgctxt "mathcat"
msgid "Move up one cell"
msgstr "Déplacer une cellule vers le haut"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command moves down one cell in
#. a math table or columnar arithmetic expression.
#: src/orca/cmdnames.py:1265
msgctxt "mathcat"
msgid "Move down one cell"
msgstr "Déplacer une cellule vers le bas"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command cycles the navigation
#. granularity to coarser (Enhanced, Simple, or Character level).
#: src/orca/cmdnames.py:1270
msgctxt "mathcat"
msgid "Increase navigation granularity"
msgstr "Augmenter la granularité de la navigation"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command cycles the navigation
#. granularity to finer (Enhanced, Simple, or Character level).
#: src/orca/cmdnames.py:1275
msgctxt "mathcat"
msgid "Decrease navigation granularity"
msgstr "Diminuer la granularité de la navigation"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command toggles whether navigation
#. reads the math content or describes its structure.
#: src/orca/cmdnames.py:1280
msgctxt "mathcat"
msgid "Toggle speech mode"
msgstr "Activer ou désactiver le mode lecture"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command speaks the previous math
#. item as you would say it aloud.
#: src/orca/cmdnames.py:1285
msgctxt "mathcat"
msgid "Read previous item"
msgstr "Lire l’élément précédent"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command speaks the next math
#. item as you would say it aloud.
#: src/orca/cmdnames.py:1290
msgctxt "mathcat"
msgid "Read next item"
msgstr "Lire l’élément suivant"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command speaks the current math
#. item as you would say it aloud.
#: src/orca/cmdnames.py:1295
msgctxt "mathcat"
msgid "Read current item"
msgstr "Lire l’élément actuel"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command speaks the content of
#. the current cell in a math table.
#: src/orca/cmdnames.py:1300
msgctxt "mathcat"
msgid "Read current cell"
msgstr "Lire la cellule actuelle"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command gives a structural
#. summary of the previous math item rather than reading its content.
#: src/orca/cmdnames.py:1305
msgctxt "mathcat"
msgid "Describe previous item"
msgstr "Décrire l’élément précédent"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command gives a structural
#. summary of the next math item rather than reading its content.
#: src/orca/cmdnames.py:1310
msgctxt "mathcat"
msgid "Describe next item"
msgstr "Lire l’élément suivant"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command gives a structural
#. summary of the current math item rather than reading its content.
#: src/orca/cmdnames.py:1315
msgctxt "mathcat"
msgid "Describe current item"
msgstr "Lire l’élément actuel"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command announces the user's
#. current position within the math expression.
#: src/orca/cmdnames.py:1320
msgctxt "mathcat"
msgid "Where am I"
msgstr "Où suis-je"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command announces the user's
#. full context within the math expression.
#: src/orca/cmdnames.py:1325
msgctxt "mathcat"
msgid "Where am I (detailed)"
msgstr "Où suis-je (détaillé)"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command returns to the position
#. the user was at before the last navigation move.
#: src/orca/cmdnames.py:1330
msgctxt "mathcat"
msgid "Return to last position"
msgstr "Revenir à la dernière position"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). Place markers are bookmarks within
#. a math expression, identified by a digit 0-9. This command jumps to one.
#: src/orca/cmdnames.py:1335
msgctxt "mathcat"
msgid "Go to place marker"
msgstr "Aller au marqueur de position suivant"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). Place markers are bookmarks within
#. a math expression, identified by a digit 0-9. This command sets one.
#: src/orca/cmdnames.py:1340
msgctxt "mathcat"
msgid "Set place marker"
msgstr "Définir un marqueur de position"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). Place markers are bookmarks within
#. a math expression, identified by a digit 0-9. This command reads one.
#: src/orca/cmdnames.py:1345
msgctxt "mathcat"
msgid "Read place marker"
msgstr "Lire le marqueur de position"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). Place markers are bookmarks within
#. a math expression, identified by a digit 0-9. This command describes one.
#: src/orca/cmdnames.py:1350
msgctxt "mathcat"
msgid "Describe place marker"
msgstr "Décrire le marqueur de position"

#. Translators: Orca has a modal math navigation mode powered by MathCAT
#. (https://daisy.github.io/MathCAT). This command copies the current
#. navigation node to the clipboard in the user's preferred format
#. (MathML, LaTeX, ASCIIMath, or Speech).
#: src/orca/cmdnames.py:1356
msgctxt "mathcat"
msgid "Copy to clipboard"
msgstr "Copier vers le presse-papiers"

#. Translators: When presenting the content of a line on a web page, Orca by
#. default presents the full line, including any links or form fields on that
#. line, in order to reflect the on-screen layout as seen by sighted users.
#. Not all users like this presentation, however, and prefer to have objects
#. treated as if they were on individual lines, such as is done by Windows
#. screen readers, so that unrelated objects (e.g. links in a navbar) are not
#. all jumbled together. As a result, this is now configurable. If layout mode
#. is enabled, Orca will present the full line as it appears on the screen; if
#. it is disabled, Orca will treat each object as if it were on a separate line,
#. both for presentation and navigation. This string is associated with the Orca
#. command to manually toggle layout mode on/off.
#: src/orca/cmdnames.py:1369
msgid "Toggle layout mode"
msgstr "Basculer le mode mise en page"

#. Translators: Orca has a number of commands that override the default
#. behavior within an application. For instance, on a web page, "h" moves
#. you to the next heading. What should happen when you press an "h" in
#. an entry on a web page depends: If you want to resume reading content,
#. "h" should move to the next heading; if you want to enter text, "h"
#. should not move you to the next heading. Similarly, if you are
#. at the bottom of an entry and press Down arrow, should you leave the
#. entry? Again, it depends on if you want to resume reading content or
#. if you are editing the text in the entry. Because Orca doesn't know
#. what you want to do, it has two modes: In browse mode, Orca treats
#. key presses as commands to read the content; in focus mode, Orca treats
#. key presses as something that should be handled by the focused widget.
#. This string is associated with the Orca command to manually switch
#. between these two modes.
#: src/orca/cmdnames.py:1385
msgid "Switch between browse mode and focus mode"
msgstr "Basculer entre le mode navigation et le mode focus"

#. Translators: (Please see the previous, detailed translator notes about
#. Focus mode and Browse mode.) In order to minimize the amount of work Orca
#. users need to do to switch between focus mode and browse mode, Orca attempts
#. to automatically switch to the mode which is appropriate to the current
#. web element. Sometimes, however, this automatic mode switching is not what
#. the user wants. A good example being web apps which have their own keyboard
#. navigation and use interaction model. As a result, Orca has a command which
#. enables setting a "sticky" focus mode which disables all automatic toggling.
#. This string is associated with the Orca command to enable sticky focus mode.
#: src/orca/cmdnames.py:1396
msgid "Enable sticky focus mode"
msgstr "Activer le mode focus permanent"

#. Translators: (Please see the previous, detailed translator notes about
#. Focus mode and Browse mode.) In order to minimize the amount of work Orca
#. users need to do to switch between focus mode and browse mode, Orca attempts
#. to automatically switch to the mode which is appropriate to the current
#. web element. Sometimes, however, this automatic mode switching is not what
#. the user wants. A good example being web apps which have their own keyboard
#. navigation and use interaction model. As a result, Orca has a command which
#. enables setting a "sticky" browse mode which disables all automatic toggling.
#. This string is associated with the Orca command to enable sticky browse mode.
#: src/orca/cmdnames.py:1407
msgid "Enable sticky browse mode"
msgstr "Activer le mode navigation permanent"

#. Translators: this is for navigating among unvisited links in a document.
#: src/orca/cmdnames.py:1410
msgid "Go to previous unvisited link"
msgstr "Revenir au lien non visité précédent"

#. Translators: this is for navigating among unvisited links in a document.
#: src/orca/cmdnames.py:1413
msgid "Go to next unvisited link"
msgstr "Aller au prochain lien non visité"

#. Translators: this is for navigating among unvisited links in a document.
#: src/orca/cmdnames.py:1416
msgid "Display a list of unvisited links"
msgstr "Afficher une liste des liens non visités"

