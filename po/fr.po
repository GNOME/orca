#. ticker. https://w3c.github.io/aria/#dfn-live-region
#: src/orca/cmdnames.py:1074
msgid "Go to next live region"
msgstr "Aller à la zone dynamique suivante"

#. Translators: this is for navigating among live regions in a document. A live
#. region is an area of a web page that is periodically updated, e.g. a stock
#. ticker. https://w3c.github.io/aria/#dfn-live-region
#: src/orca/cmdnames.py:1079
msgid "Go to the last live region which made an announcement"
msgstr "Revenir à la dernière zone dynamique qui a effectué une annonce"

#. Translators: this is for navigating among math expressions in a document.
#: src/orca/cmdnames.py:1082
msgid "Go to previous math expression"
msgstr "Aller à l’expression mathématique précédente"

#. Translators: this is for navigating among math expressions in a document.
#: src/orca/cmdnames.py:1085
msgid "Go to next math expression"
