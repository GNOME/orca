msgid "faster."
msgstr "უფროსწრაფად."

#. Translators: This string announces speech rate change.
#: src/orca/messages.py:1976
msgid "slower."
msgstr "უფრონელა."

#. Translators: This string announces speech pitch change.
#: src/orca/messages.py:1979
msgid "higher."
msgstr "უფრომაღლა."

#. Translators: This string announces speech pitch change.
#: src/orca/messages.py:1982
msgid "lower."
msgstr "უფროდაბლა."

#. Translators: This string announces speech volume change.
#: src/orca/messages.py:1985
msgid "louder."
msgstr "უფროხმამაღლა."

#. Translators: This string announces speech volume change.
#: src/orca/messages.py:1988
msgid "softer."
msgstr "უფრორბილად."

#. Translators: This string announces speech inflection (pitch range) change.
#: src/orca/messages.py:1991
msgid "more inflection."
msgstr "ტონის მეტი ცვლილება."

#. Translators: This string announces speech inflection (pitch range) change.
#: src/orca/messages.py:1994
msgid "less inflection."
msgstr "ტონის ნაკლები ცვლილება."

