  <section id="commands-documents">
    <title>Commands</title>
    <p>
      <em style="strong">Preferences location:</em>
      <gui>Commands</gui> category, <gui>Commands</gui> section, <gui>Documents</gui> group.
    </p>
    <list>
      <item>
        <p>
          <gui>Switch between browse mode and focus mode</gui>: <keyseq>
            <key>Orca Modifier</key>
            <key>A</key>
          </keyseq>
        </p>
      </item>
      <item>
        <p>
          <gui>Enable sticky focus mode</gui>: <keyseq>
            <key>Orca Modifier</key>
            <key>A</key>
          </keyseq>
          (press twice quickly)
        </p>
        <p>
          Keeps Orca in focus mode until you explicitly change modes, overriding automatic
          switching.
        </p>
      </item>
      <item>
        <p>
          <gui>Enable sticky browse mode</gui>: <keyseq>
            <key>Orca Modifier</key>
            <key>A</key>
          </keyseq>
          (press three times quickly)
        </p>
        <p>
          Keeps Orca in browse mode until you explicitly change modes, overriding automatic
          switching.
        </p>
      </item>
    </list>
  </section>
