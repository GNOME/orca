    <section id="flat-review-starting-and-positioning-review">
      <title>Starting and positioning review</title>
      <list>
        <item>
          <p>
            <gui>Enter and exit flat review mode</gui>: Toggling flat
            review off and back on discards the previous review location and starts again at the
            focus.
          </p>
          <list>
            <item>
              <p>
                Desktop: <keyseq>
                  <key>Keypad Subtract</key>
                </keyseq>
              </p>
            </item>
            <item>
              <p>
                Laptop: <keyseq>
                  <key>Orca Modifier</key>
                  <key>P</key>
                </keyseq>
              </p>
            </item>
            <item>
              <p>
                Braille: Freeze
              </p>
            </item>
          </list>
        </item>
        <item>
          <p>
            <gui>Move flat review to the home position</gui>: Moves to the
            beginning of the window's content.
          </p>
          <list>
            <item>
              <p>
                Desktop: <keyseq>
                  <key>Orca Modifier</key>
                  <key>Keypad 7</key>
                </keyseq>
              </p>
            </item>
            <item>
              <p>
                Laptop: <keyseq>
                  <key>Orca Modifier</key>
                  <key>Ctrl</key>
                  <key>U</key>
                </keyseq>
              </p>
            </item>
            <item>
              <p>
                Braille: Top Left
              </p>
            </item>
          </list>
        </item>
        <item>
          <p>
            <gui>Move flat review to the end position</gui>: Moves to the last
            item in the window.
          </p>
          <list>
            <item>
              <p>
                Desktop: <keyseq>
                  <key>Orca Modifier</key>
                  <key>Keypad 9</key>
                </keyseq>
              </p>
            </item>
            <item>
              <p>
                Laptop: <keyseq>
                  <key>Orca Modifier</key>
                  <key>Ctrl</key>
                  <key>O</key>
                </keyseq>
              </p>
            </item>
          </list>
        </item>
        <item>
          <p>
            <gui>Move flat review to the bottom left</gui>: Moves to the start
            of the last line.
          </p>
          <list>
            <item>
              <p>
                Keyboard: unbound by default.
              </p>
            </item>
            <item>
              <p>
                Braille: Bottom Left
              </p>
            </item>
          </list>
        </item>
        <item>
          <p>
            <gui>Move flat review to the object with focus</gui>: Moves review to
            the current focus or caret without changing the tracking setting. Unbound by
            default.
          </p>
        </item>
        <item>
          <p>
            <gui>Move focus to the flat review location</gui>: Attempts to move
            focus and the caret to the reviewed location. This requires support from the
            application. Unbound by default.
          </p>
        </item>
      </list>
    </section>
